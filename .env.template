# Copia este archivo a .env y rellena los valores. Nunca commitees .env.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Destinatario del formulario de contacto.
# Con onboarding@resend.dev debe ser el email de tu cuenta Resend.
CONTACT_TO_EMAIL=

# Remitente. Cambia solo este valor al verificar un dominio propio.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"

# Contraseña de la base de datos de Supabase. 
SUPABASE_DB_PASSWORD=

# URL del proyecto Supabase (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# Clave publishable (sb_publishable_...). Es pública por diseño: la seguridad real la da RLS.
# Nunca pongas aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=