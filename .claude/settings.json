{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-lint.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true
  }
}
